# ==================== Django Settings ====================
# Django secret key for cryptographic signing
# Generate a new one using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY='django-insecure-cf7%y*&gdzxf7l%f9x*^@c)s)=xk%wq0b438#1d@$+(l&!h4%x'

# Debug mode: True for development, False for production
DEBUG=True

# ==================== Database Configuration ====================
# MySQL database name
DB_NAME=mock_interview_platform

# MySQL username
DB_USER=root

# MySQL password - CHANGE THIS IN PRODUCTION!
DB_PASSWORD=demopass

# MySQL host (container name or IP address)
# Use 'mysql8-container' when running in Docker
# Use '192.168.1.123' or actual IP for external access
DB_HOST=mysql8-container

# MySQL port
DB_PORT=3306

# ==================== HDFS Configuration ====================
# HDFS NameNode hostname or IP address
HDFS_HOST=192.168.1.123

# HDFS WebHDFS port
HDFS_PORT=9870

# HDFS user for file operations
HDFS_USER=hdfs

