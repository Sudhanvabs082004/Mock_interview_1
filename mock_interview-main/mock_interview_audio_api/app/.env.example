# ============================================
# Mock Interview Audio API - Environment Variables
# ============================================
# Copy this file to .env and replace with your actual values
# NEVER commit the actual .env file to version control!
#
# ⚠️ IMPORTANT: API keys shown below are FOR REFERENCE ONLY!
# You MUST generate your own keys from:
#   - OpenRouter: https://openrouter.ai/
# ============================================

# ==================== Database Configuration ====================
# MySQL database name
DB_NAME=mock_interview_platform

# MySQL username
DB_USER=root

# MySQL password - CHANGE THIS IN PRODUCTION!
DB_PASSWORD=demopass

# MySQL host (container name or IP address)
# Use 'mysql8-container' when running in Docker
# Use '192.168.1.123' or actual IP for external access
DB_HOST=mysql8-container

# MySQL port
DB_PORT=3306

# ==================== HDFS Configuration ====================
# HDFS NameNode hostname or IP address
HDFS_HOST=192.168.1.123

# HDFS WebHDFS port
HDFS_PORT=9870

# HDFS user for file operations
HDFS_USER=hdfs

# ==================== API Keys ====================
# OpenRouter API key for DeepSeek (answer grading)
# Get your key from: https://openrouter.ai/
OPENROUTER_API_KEY=
